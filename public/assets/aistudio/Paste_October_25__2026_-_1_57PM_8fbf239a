      /* Fluid Ambient Background layout */
      .app-container {
        position: relative;
        overflow: hidden;
      }
      .ambient-glow-orb {
        position: absolute;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        filter: blur(130px);
